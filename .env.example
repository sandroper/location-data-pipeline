# Snowflake Connection Configuration
# Copy this file to .env and update with your actual values
# For different environments, create .env.dev, .env.prod, etc. and source them accordingly

SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_URL=
SNOWFLAKE_USER=your_username
# Private key authentication - key file should be at sf_k2ib_key.p8 (or set SNOWFLAKE_KEY_PATH)
# SNOWFLAKE_KEY_PATH=path/to/your/key.p8
SNOWFLAKE_DATABASE=your_database
SNOWFLAKE_SCHEMA=your_schema
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_ROLE=
SNOWFLAKE_TABLE=your_table
